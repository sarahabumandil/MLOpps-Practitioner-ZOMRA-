{
  "title": "arasent — Sentiment Service",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "p95 latency (prediction_latency_seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(prediction_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 2,
      "title": "Predictions per second by label",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(predictions_total[1m])) by (label)",
          "legendFormat": "{{label}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Prediction confidence distribution",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(increase(prediction_confidence_bucket[1h])) by (le)",
          "format": "heatmap"
        }
      ]
    },
    {
      "id": 4,
      "title": "In-flight / error rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(predictions_total{status=\"error\"}[5m])) / sum(rate(predictions_total[5m]))",
          "legendFormat": "error rate"
        }
      ]
    }
  ]
}
