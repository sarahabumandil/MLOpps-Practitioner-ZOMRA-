# Real secrets for the compose stack — only .env.example belongs in git.
.env

# Generated by the drift scripts
reports/
data/

# Local venv
.venv/

# Generated by `make bootstrap` — the frozen model, scalers and drift reference.
# Regenerate with `python -m services.ride_model`; never commit a pickle.
artifacts/

# The metrics store (drift rows, late labels, deploys, retrain decisions) and
# the incident engine's runtime state. Both are rebuilt by `make seed`.
metrics_store.db
incidents/state.json

# Saved RAGAS runs, for --compare. The frozen testset and its hash ARE committed
# (they are the measurement's identity); individual run results are not.
evals/runs/
